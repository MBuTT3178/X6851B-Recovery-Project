# Screen settings (Infinix Note 40 Pro+ 5G 1080x2436 3D-Curved AMOLED)
OF_SCREEN_H := 2436
OF_STATUS_H := 90
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_ALLOW_DISABLE_NAVBAR := 1
OF_SETTINGS_CUSTOM_PATH := /sdcard/Fox
OF_CHECK_OVERWRITE_ATTEMPTS := 1
OF_ALLOW_DISABLE_FORCE_ENCRYPTION := 1
OF_SUPPORT_ALL_PAYLOAD_EXTRACTOR := 1
OF_SUPPORT_ALL_BLOCK_SU_MOUNTS := 1
OF_DYNAMIC_FULL_SIZE := 12884901888
OF_CLOCK_POS := 0
OF_FORCE_CASEFOLDING := 1

# Flashlight (MediaTek torch driver)
OF_FLASHLIGHT_ENABLE := 1
OF_FL_PATH1 := /sys/class/torch/torch
OF_FL_PATH2 := /sys/devices/virtual/flashlight_core/flashlight/flashlight_torch
OF_USE_GREEN_LED := 0

# Vibration & Haptics (MT6369 / Regulator-Vibrator)
OF_ENABLE_VIBRATION := 1
OF_VIBRATION_DEFAULT_DURATION := 100
CUSTOM_VIBRATOR_PATH := /sys/class/leds/vibrator/brightness
OF_USE_NEW_HAPTICS := 1

# Backup & Storage
OF_QUICK_BACKUP_LIST := /boot;/data;
OF_ENABLE_LPTOOLS := 1
OF_ENABLE_ALL_PARTITION_TOOLS := 1
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1
OF_OPTIONS_LIST_NUM := 9
OF_UNBIND_SDCARD_F2FS := 1
OF_WIPE_METADATA_AFTER_DATAFORMAT := 1
OF_BIND_MOUNT_SDCARD_ON_FORMAT := 0
OF_LOOP_DEVICE_ERRORS_TO_LOG := 1

# Device Identity & Compatibility
OF_MAINTAINER := 29exop
FOX_TARGET_DEVICES := Infinix-X6851B,X6851B,Infinix_X6851B,Infinix-Note-40-Pro-Plus
FOX_DEVICE_MODEL := Infinix Note 40 Pro+ 5G
FOX_COMPATIBILITY_DEVICE := Infinix Note 40 Pro+ 5G (Infinix X6851B)

# Build configuration per OrangeFox Wiki
FOX_VANILLA_BUILD := 1

# Magisk & AVB
OF_USE_MAGISKBOOT := 1
OF_USE_MAGISKBOOT_FOR_ALL_PATCHES := 1
OF_PATCH_AVB20 := 1

# Advanced Security & Decryption
OF_DEFAULT_KEYMASTER_VERSION := 5.0
OF_SUPPORT_OZIP_DECRYPTION := 1
OF_FBE_METADATA_MOUNT_IGNORE := 0
OF_SKIP_DECRYPTED_ADOPTED_STORAGE := 1
OF_SPLASH_MAX_SIZE := 8192
OF_USE_AIDL_BOOT_CONTROL := 1
OF_SUPPORT_VBMETA_AVB2_PATCHING := 1
OF_ENABLE_FRP_ADDON := 1

# Rooting Engine
FOX_DELETE_MAGISK_ADDON := 0
FOX_ENABLE_KERNELSU_SUPPORT := 1
FOX_ENABLE_KERNELSU_NEXT_SUPPORT := 1
FOX_ENABLE_SUKISU_SUPPORT := 1
OF_FORCE_PREBUILT_KERNEL := 1
